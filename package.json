{
  "name": "project-war",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node game/tests.mjs && node game/run-tests.mjs && node campaign/tests.mjs && node game/party-tests.mjs",
