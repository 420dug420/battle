    "server:deploy": "cd server && wrangler deploy"
  },
  "devDependencies": {
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "esbuild": "^0.24.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
